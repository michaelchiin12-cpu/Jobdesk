# Salin ke .env.local untuk pengembangan lokal. Di Vercel isi lewat Project Settings > Environment Variables.
# Kedua nilai ini kunci publik (anon), aman ada di sisi browser. Jangan pernah memakai service role key.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ISI_DENGAN_ANON_KEY

# Email akun bersama tim di Supabase Auth. Kode akses tim = password akun ini.
NEXT_PUBLIC_TEAM_EMAIL=tim@jobdesk.example.com

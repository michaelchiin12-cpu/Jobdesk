# Salin ke .env.local untuk pengembangan lokal. Di Vercel isi lewat Project Settings > Environment Variables.
# Dua nilai pertama adalah kunci publik (anon), aman di sisi browser. Jangan pernah memakai service role key.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ISI_DENGAN_ANON_KEY

# Dua akun login di Supabase Auth. Kode akses = password akun. Peran ditentukan tabel app_roles di database.
NEXT_PUBLIC_TEAM_EMAIL=tim@jobdesk.example.com
NEXT_PUBLIC_LEAD_EMAIL=lead@jobdesk.example.com

# Web Push (notifikasi saat tab ditutup). Buat pasangan kunci: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:email-anda@example.com
# Rahasia bersama antara database dan route /api/push. Nilai yang sama dimasukkan ke app_private.settings (lihat README).
PUSH_SECRET=

# Opsional: mode tanpa layar login. Isi dengan kode akses akun bersama. Nilai ini TERLIHAT PUBLIK di browser,
# jadi siapa pun yang tahu alamat situs bisa melihat dan mengubah data. Kosongkan untuk memakai layar login.
NEXT_PUBLIC_OPEN_PASSWORD=
